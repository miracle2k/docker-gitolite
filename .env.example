# Mochi API token: Mochi > Settings > API. Requires Mochi Pro.
MOCHI_API_TOKEN=

# Bearer token callers must present to the MCP server. Generate one with
#   openssl rand -hex 32
# Without it, anyone who can reach the port can read and tag your cards.
MCP_AUTH_TOKEN=

# Only needed for the voice broker.
OPENAI_API_KEY=
BROKER_AUTH_TOKEN=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# --- Review strategy -------------------------------------------------------
# verbatim | rephrase | contextual
REVIEW_QUESTION_STYLE=rephrase
# lenient | balanced | strict
REVIEW_STRICTNESS=balanced
# A year answer within this many years counts as recalled.
REVIEW_YEAR_TOLERANCE=3
# Other numbers count if within this fraction (0.05 = 5%).
REVIEW_RELATIVE_TOLERANCE=0.05
# immediate | end-of-session. Deferred writes make late corrections free.
REVIEW_SYNC_MODE=end-of-session
# least-recent | forward-only | random
REVIEW_PROMPT_SELECTION=least-recent
REVIEW_MAX_CARDS=0

# --- Write-back ------------------------------------------------------------
# Mochi's API cannot record reviews. Tagging missed cards is the only
# officially supported write, so you can filter to them in the Mochi app.
MOCHI_TAG_SINK=true
MOCHI_FORGOT_TAG=voice-forgot
# MOCHI_REMEMBERED_TAG=voice-ok

# If you have some other endpoint that CAN record a review, point this at it.
# GRADE_WEBHOOK_URL=
# GRADE_WEBHOOK_HEADERS={"Authorization":"Bearer ..."}
# GRADE_WEBHOOK_BODY={"card-id":"{{cardId}}","remembered?":"{{remembered}}"}
# GRADE_WEBHOOK_ADVANCES_SCHEDULE=false
