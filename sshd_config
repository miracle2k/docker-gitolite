# -*- mode: conf -*-

# SSH is intentionally restricted to Gitolite's git account.
Port 2222
TCPKeepAlive no

# The log is sent to stderr and captured by Docker.
LogLevel VERBOSE
# sshd runs as git, so keep its optional pid file in a writable location.
PidFile /home/git/.sshd.pid

# Authentication and account restrictions.
LoginGraceTime 30
StrictModes no     # Required because repository volumes can have host modes.
PermitRootLogin no
AllowUsers git

PrintMotd no
PrintLastLog no

PubkeyAuthentication yes
AuthenticationMethods publickey
# Support legacy clients that can sign RSA keys only with ssh-rsa (SHA-1).
PubkeyAcceptedAlgorithms +ssh-rsa
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
HostbasedAuthentication no
KerberosAuthentication no
GSSAPIAuthentication no

# Disable features that are not needed for Gitolite over SSH.
PermitTTY no
AllowAgentForwarding no
PermitUserRC no
AllowStreamLocalForwarding no
AllowTcpForwarding no
PermitTunnel no
X11Forwarding no
GatewayPorts no
PermitOpen none
